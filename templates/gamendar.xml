<?xml version="1.0"?>
<Container version="2">
  <Name>Gamendar</Name>
  <Repository>ghcr.io/ryancallister/gamendar:latest</Repository>
  <Registry>https://ghcr.io/ryancallister/gamendar</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/ryancallister/Gamendar/issues</Support>
  <Project>https://github.com/ryancallister/Gamendar</Project>
  <Overview>Self-hosted team availability scheduler...</Overview>
  <Category>Productivity: Tools:</Category>
  <WebUI>http://[IP]:[PORT:5000]/</WebUI>
  <Icon>https://raw.githubusercontent.com/ryancallister/Gamendar/main/icon.png</Icon>

  <Config Name="WebUI Port" Target="5000" Default="3005" Mode="tcp"
          Description="Host port for the web interface"
          Type="Port" Display="always" Required="true" Mask="false">3005</Config>

  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/gamendar" Mode="rw"
          Description="SQLite database lives here"
          Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/gamendar</Config>

  <Config Name="SECRET_KEY" Target="SECRET_KEY" Default="" Mode=""
          Description="Leave blank to auto-generate one into the data volume."
          Type="Variable" Display="always" Required="false" Mask="true"></Config>
</Container>