# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# OPTIONAL: the JWT signing secret.
# Leave this blank and the app generates a strong key on first start and keeps
# it at ./data/secret_key, so sessions survive restarts. Set it explicitly if
# you'd rather manage the secret yourself (e.g. to share it between hosts).
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Port the app will be accessible on (default: 3005)
APP_PORT=3005

# Set to true only for local development
FLASK_DEBUG=false
